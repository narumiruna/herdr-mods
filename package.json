{
  "name": "herdr-mod-manager",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/herdr-mod-manager.git"
  },
  "scripts": {
    "start": "herdr-app do mod.open --name mod-manager",
    "check:mod": "herdr-app check .",
    "check:types": "tsc --project jsconfig.json",
    "check": "biome ci .",
    "test": "vitest run",
    "ci": "npm run check && npm test && npm run check:types",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
