  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/herdr-mods.git",
    "directory": "mods/better-files"
  },
  "scripts": {
    "check:mod": "node scripts/check-native.mjs",
    "check:views": "node scripts/check-native.mjs --views",
