    "mathjax-full": "3.2.2",
    "mdast-util-to-hast": "13.2.2",
    "mermaid": "12.3.0",
    "puppeteer": "25.17.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "vega": "6.4.0",
    "vega-lite": "6.5.0"
  }
